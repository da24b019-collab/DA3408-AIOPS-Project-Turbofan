# Copy this file to .env and fill in the values:   cp .env.example .env
# .env is NOT committed to Git (it holds the API key).

# Your laptop user and group ids (run: id -u ; id -g). The containers run as
# this user, so the files they write in the project folder belong to you.
HOST_UID=1000
HOST_GID=1000

# Shared secret between the dashboard and the backend. Generate one with:
#   openssl rand -hex 16
API_KEY=change-me

# Docker Hub account used to name (and later push) the images
DOCKERHUB_USER=local
IMAGE_TAG=latest

# ---- Monitoring (Task 8) ----
# Password of the Grafana "admin" user (http://localhost:3000). Generate one:
#   openssl rand -hex 12
GRAFANA_ADMIN_PASSWORD=change-me
# Where Docker keeps its data (cAdvisor reads it). Find yours with:
#   docker info --format '{{ .DockerRootDir }}'
DOCKER_DATA_DIR=/var/lib/docker
